{
  "$schema": "https://example.com/process-class-manifest-v1.schema.json",
  "specVersion": "1.1",
  "type": "stdin",
  "name": "letak-worker-coopjednota",
  "version": "1.2.1",
  "description": "Detects new COOP Jednota Slovensko leaflets on coop.sk/letaky (nationwide Potraviny/Supermarket/Tempo, Tempo, regional) and returns their metadata + PDF URLs (no downloads).",
  "author": "sim0n92",
  "repository": "https://github.com/sim0n92/letak-worker-coopjednota",
  "authentication": false,
  "actions": {
    "execute": {
      "description": "Fetch coop.sk/letaky (JSON-LD list), resolve each new leaflet's PDF through its Adobe InDesign viewer, and return the leaflets not present in knownLeaflets. A list without leaflets (NO_LEAFLETS) or a leaflet without PDF (PDF_NOT_FOUND) is an error.",
      "input": {
        "type": "object",
        "required": [
          "outputPath"
        ],
        "properties": {
          "outputPath": {
            "type": "string",
            "description": "Absolute path where the result JSON document must be written."
          },
          "knownLeaflets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Leaflet keys already known to the caller, each formatted as 'type|from|to|id' (id = the leaflet page slug, e.g. 'tempo-43-2026'). NOTE: unlike other chains' 3-part 'type|from|to' key, coopjednota uses a 4-part key because its federated regional co-ops can publish multiple distinct leaflets under the same banner and date range at once - the 'id' disambiguates them."
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Case-insensitive banner filter: 'CoopPotraviny' (the nationwide Potraviny, Supermarket a Tempo leaflet), 'Tempo', 'Regional'. Empty means all."
          },
          "pageUrl": {
            "type": "string",
            "description": "Override for the leaflet list URL. Defaults to https://www.coop.sk/letaky"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "outputPath": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "hasNew": {
            "type": "boolean"
          },
          "leaflets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Store banner: 'CoopPotraviny', 'Tempo' or 'Regional'."
                },
                "from": {
                  "type": "string",
                  "format": "date"
                },
                "to": {
                  "type": "string",
                  "format": "date"
                },
                "id": {
                  "type": "string",
                  "description": "Slug of the leaflet's page on coop.sk (e.g. 'tempo-43-2026'). Part of the novelty key alongside type+from+to (coopjednota-specific 4-part key) - regional leaflets can share type and dates."
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Directly downloadable PDF (indd.adobe.com/view/publication/<id>/<version>/publication-web-resources/pdf/...)."
                }
              },
              "required": [
                "type",
                "from",
                "to",
                "id",
                "url"
              ]
            }
          },
          "fileSize": {
            "type": "integer"
          }
        }
      }
    },
    "spec": {
      "description": "Return the config and output JSON schemas (Proc-protocol 1.1).",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "configSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "protocol": {
            "type": "string",
            "const": "1.1"
          }
        }
      }
    },
    "check": {
      "description": "Test Source: fetch and parse the listing; ok when at least one leaflet is found.",
      "input": {
        "type": "object",
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "state": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "seen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "pageUrl": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "run": {
      "description": "Detect new leaflets: items = leaflets not in state.seen (and of the requested types), state = seen keys.",
      "input": {
        "type": "object",
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "state": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "seen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "pageUrl": {
            "type": "string"
          },
          "knownLeaflets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Legacy compatibility: keys treated as already seen, in addition to state.seen."
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "items",
          "state",
          "metrics",
          "checks"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "url",
                "meta"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "meta": {
                  "type": "object",
                  "required": [
                    "type",
                    "validFrom",
                    "validTo"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "validFrom": {
                      "type": "string"
                    },
                    "validTo": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "state": {
            "type": "object",
            "required": [
              "seen"
            ],
            "properties": {
              "seen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "leaflets": {
                "type": "integer"
              },
              "newLeaflets": {
                "type": "integer"
              },
              "skippedNoPdf": {
                "type": "integer"
              }
            }
          },
          "checks": {
            "type": "array"
          }
        }
      }
    },
    "terminate": {
      "description": "Stop an in-progress fetch/parse and exit cleanly.",
      "input": {
        "type": "object",
        "properties": {
          "originalExecutionId": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "cleaned": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "execution": {
    "timeout": 180,
    "memoryLimit": "256Mi",
    "cpuLimit": "0.5"
  }
}
